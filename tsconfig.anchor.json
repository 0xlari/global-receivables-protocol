{
  "compilerOptions": {
    "types": ["mocha", "chai", "node"],
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["tests-anchor/**/*.ts", "target/types/**/*.ts"]
}
